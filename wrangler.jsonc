{
  // Statische Website (Vite-Build) auf Cloudflare: `npm run build` erzeugt ./dist,
  // `npx wrangler deploy` lädt es hoch. Der Feedback-Worker liegt separat in feedback-worker/.
  "name": "fvpc-web",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
